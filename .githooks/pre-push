#!/bin/sh
# Fast feedback before a push. CI (.github/workflows/test.yml) runs all of
# this plus lint, typecheck and the Playwright suite; this hook covers the
# parts quick enough not to be annoying -- together about two seconds.
#
# The demo fixture check is the slow one and stays because it is the only
# thing standing between a stale fixture and a Vercel deploy.
#
# Needs uv on PATH, same as `npm run dev`.
set -e

uv run --group dev pytest -q
npm test --silent
npm run --silent check:demo
